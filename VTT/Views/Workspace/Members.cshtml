@model List<WorkspaceMember>
@{
    ViewData["Title"] = "Thành viên Không gian làm việc";
    var ws = ViewBag.Workspace as Workspace;
    var isAdmin = ViewBag.IsAdmin == true;
    int meId = ViewBag.MeId is int id ? id : 0;
}

<div class="dashboard-container">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px;">
        <div>
            <h1 style="font-size: 24px; font-weight: 800; color: var(--text-main);">Thành viên Không gian làm việc</h1>
            <p style="font-size: 13.5px; color: var(--text-muted);">
                Quản lý quyền truy cập và cộng tác của các thành viên trong <b>@(ws?.Name ?? "Không gian làm việc VTT")</b>
            </p>
        </div>
        <div style="display: flex; gap: 10px;">
            @if (ws != null && ws.OwnerId != meId)
            {
                <form asp-action="Leave" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn rời khỏi không gian làm việc này? Bạn sẽ mất quyền truy cập vào các bảng trong đó.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-ghost">Rời khỏi không gian</button>
                </form>
            }
            @if (isAdmin)
            {
                <button type="button" class="btn btn-primary" onclick="Modal.open('invite-member-modal')">
                    <span>+ Mời thành viên</span>
                </button>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div style="background: var(--success-bg); color: var(--success-text); padding: 12px 16px; border-radius: var(--radius-sm); font-size: 13.5px; font-weight: 600; margin-bottom: 20px; border: 1px solid rgba(85,239,196,0.5); display: flex; align-items: center; gap: 8px;">
            <span>✓</span>
            <span>@TempData["Success"]</span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div style="background: var(--danger-bg); color: var(--danger-text); padding: 12px 16px; border-radius: var(--radius-sm); font-size: 13.5px; font-weight: 600; margin-bottom: 20px; border: 1px solid rgba(255,118,117,0.3); display: flex; align-items: center; gap: 8px;">
            <span>⚠</span>
            <span>@TempData["Error"]</span>
        </div>
    }

    <!-- Members Table Card -->
    <div style="background: #ffffff; border-radius: var(--radius-md); border: 1px solid var(--border-light); box-shadow: var(--shadow-sm); overflow: hidden;">
        <div style="padding: 16px 20px; background: var(--bg-subtle); border-bottom: 1px solid var(--border-light); display: flex; justify-content: space-between; align-items: center;">
            <div style="font-weight: 700; font-size: 14px; color: var(--text-main);">
                Danh sách thành viên (@Model.Count)
            </div>
            <span style="font-size: 12px; color: var(--text-subtle);">Chủ sở hữu: <b>@(ws?.Owner?.FullName ?? "Chưa xác định")</b></span>
        </div>

        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13.5px;">
                <thead>
                    <tr style="border-bottom: 1px solid var(--border-light); color: var(--text-muted); font-size: 12px; text-transform: uppercase;">
                        <th style="padding: 12px 20px;">Thành viên</th>
                        <th style="padding: 12px 20px;">Email</th>
                        <th style="padding: 12px 20px;">Vai trò</th>
                        <th style="padding: 12px 20px;">Ngày tham gia</th>
                        <th style="padding: 12px 20px; text-align: right;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        var u = m.User;
                        var initial = string.IsNullOrEmpty(u?.FullName) ? "U" : u.FullName[0].ToString().ToUpper();
                        var isOwner = ws?.OwnerId == m.UserId;

                        <tr style="border-bottom: 1px solid var(--border-light);">
                            <td style="padding: 14px 20px; display: flex; align-items: center; gap: 12px;">
                                <div class="avatar">@initial</div>
                                <div>
                                    <div style="font-weight: 700; color: var(--text-main);">@(u?.FullName ?? "N/A")</div>
                                    <div style="font-size: 12px; color: var(--text-muted);">@@@(u?.UserName ?? "user")</div>
                                </div>
                            </td>
                            <td style="padding: 14px 20px; color: var(--text-muted);">@(u?.Email ?? "-")</td>
                            <td style="padding: 14px 20px;">
                                @if (m.Role == "Admin")
                                {
                                    <span class="badge badge-pink">Quản trị viên</span>
                                }
                                else
                                {
                                    <span class="badge" style="background: var(--bg-subtle); color: var(--text-muted);">Thành viên</span>
                                }
                                @if (isOwner)
                                {
                                    <span class="badge" style="background: #fff9db; color: #d97706; margin-left: 4px;">Chủ sở hữu</span>
                                }
                            </td>
                            <td style="padding: 14px 20px; color: var(--text-subtle); font-size: 12.5px;">
                                @m.JoinedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td style="padding: 14px 20px; text-align: right;">
                                @if (!isAdmin)
                                {
                                    <span style="font-size: 12px; color: var(--text-subtle);">-</span>
                                }
                                else if (!isOwner)
                                {
                                    <div style="display: inline-flex; gap: 8px;">
                                        <form asp-action="UpdateRole" method="post" style="display: inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@m.UserId" />
                                            <input type="hidden" name="role" value="@(m.Role == "Admin" ? "Member" : "Admin")" />
                                            <button type="submit" class="btn btn-ghost btn-sm" title="Đổi vai trò">
                                                @(m.Role == "Admin" ? "Chuyển thành Thành viên" : "Thăng cấp Quản trị viên")
                                            </button>
                                        </form>

                                        <form asp-action="RemoveMember" method="post" style="display: inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa thành viên này khỏi nhóm?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@m.UserId" />
                                            <button type="submit" class="btn btn-danger btn-sm" title="Xóa khỏi nhóm">
                                                Xóa
                                            </button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span style="font-size: 12px; color: var(--text-subtle); font-style: italic;">Chủ sở hữu</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Mời thành viên mới -->
<div class="modal-overlay" id="invite-member-modal" role="dialog" aria-modal="true">
    <div class="modal-window" style="width: 480px;">
        <div class="modal-header">
            <h3 class="modal-title">Mời thành viên vào Không gian làm việc</h3>
            <button type="button" class="modal-close-btn" data-modal-close aria-label="Đóng">✕</button>
        </div>

        <form asp-action="Invite" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <div class="form-group">
                    <label class="form-label" for="invite-account">Email hoặc Tên người dùng <span style="color:var(--danger)">*</span></label>
                    <input type="text" class="form-control" id="invite-account" name="emailOrUsername" placeholder="VD: email hoặc tên người dùng" maxlength="256" required autofocus />
                    <small style="color: var(--text-subtle); font-size: 12px; margin-top: 4px; display: block;">
                        Chỉ người được mời mới thấy các bảng của không gian này. Người dùng cần có tài khoản trong hệ thống.
                    </small>
                </div>

                <div class="form-group" style="margin-bottom: 0;">
                    <label class="form-label" for="invite-role">Vai trò</label>
                    <select class="form-control" id="invite-role" name="role">
                        <option value="Member">Thành viên (Có quyền xem và chỉnh sửa thẻ)</option>
                        <option value="Admin">Quản trị viên (Toàn quyền quản lý không gian)</option>
                    </select>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" data-modal-close>Hủy</button>
                <button type="submit" class="btn btn-primary">Mời thành viên</button>
            </div>
        </form>
    </div>
</div>
