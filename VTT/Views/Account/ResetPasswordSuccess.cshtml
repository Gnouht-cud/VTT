@{
    ViewData["Title"] = "Đặt lại mật khẩu thành công";
}
<div style="min-height:calc(100vh - 120px); display:flex; align-items:center; justify-content:center; padding:32px 16px;">
    <div style="width:100%; max-width:440px; background:#fff; border-radius:var(--radius-lg); box-shadow:var(--shadow-lg); border:1px solid var(--border-light); padding:36px 32px; text-align:center;">
        <h1 style="font-size:22px; font-weight:800; margin-bottom:12px;">Đặt lại mật khẩu thành công</h1>
        <p style="color:var(--text-muted); margin-bottom:24px;">@ViewBag.Success</p>
        <a asp-action="Login" class="btn btn-primary" style="display:block; text-decoration:none; padding:10px;">Đăng nhập</a>
    </div>
</div>
