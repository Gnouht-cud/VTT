@{
    ViewData["Title"] = "Quên mật khẩu";
}
<div style="min-height: calc(100vh - 120px); display:flex; align-items:center; justify-content:center; padding:32px 16px;">
    <div style="width:100%; max-width:440px; background:#fff; border-radius:var(--radius-lg); box-shadow:var(--shadow-lg); border:1px solid var(--border-light); padding:36px 32px;">
        <h1 style="font-size:22px; font-weight:800; color:var(--text-main); margin-bottom:8px;">Quên mật khẩu?</h1>
        <p style="font-size:13.5px; color:var(--text-muted); margin-bottom:24px;">Nhập email đã đăng ký. Nếu tài khoản tồn tại, chúng tôi sẽ gửi liên kết đặt lại mật khẩu.</p>
        @if (ViewBag.Error != null) { <div class="alert alert-danger" role="alert">@ViewBag.Error</div> }
        @if (ViewBag.Success != null) { <div style="background:var(--success-bg, #e8f8ef); color:var(--success-text, #176b3a); padding:12px; border-radius:8px; margin-bottom:16px;">@ViewBag.Success</div> }
        @if (ViewBag.DevelopmentResetUrl != null) {
            <div style="padding:12px; background:#fff8e1; border-radius:8px; overflow-wrap:anywhere; font-size:13px;">
                <strong>Link thử nghiệm (Development):</strong><br />
                <a href="@ViewBag.DevelopmentResetUrl">@ViewBag.DevelopmentResetUrl</a>
            </div>
        }
        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="form-label" for="email">Địa chỉ email</label>
                <input class="form-control" type="email" id="email" name="email" autocomplete="email" required placeholder="email@domain.com" />
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%; padding:10px;">Gửi liên kết đặt lại</button>
        </form>
        <div style="text-align:center; margin-top:22px; font-size:13px;">
            <a asp-action="Login" style="color:var(--primary-hover); font-weight:700;">← Quay lại đăng nhập</a>
        </div>
    </div>
</div>
