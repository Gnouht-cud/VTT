@* Sidebar thu gọn / mở rộng toàn hệ thống *@
@{
    var currentMember = await Access.GetCurrentAsync();
    var memberships = await Access.GetMembershipsAsync();
    var wsName = currentMember?.Workspace?.Name ?? "Không gian VTT";
    var wsInitial = string.IsNullOrEmpty(wsName) ? "V" : wsName[0].ToString().ToUpper();
    var isWsAdmin = currentMember?.Role == "Admin";
}
<aside class="app-sidebar">
    <div class="sidebar-workspace">
        <div class="ws-avatar">@wsInitial</div>
        <div class="ws-info">
            <div class="ws-name" title="@wsName">@wsName</div>
            <div class="ws-sub">@(isWsAdmin ? "Quản trị viên" : "Thành viên")</div>
        </div>
    </div>

    @if (memberships.Count > 0)
    {
        <div class="sidebar-section ws-switcher">
            <div class="sidebar-section-title">Không gian làm việc</div>
            <form asp-controller="Workspace" asp-action="Switch" method="post">
                @Html.AntiForgeryToken()
                <select name="id" class="form-control ws-switch-select" aria-label="Chọn không gian làm việc" onchange="this.form.submit()">
                    @foreach (var m in memberships)
                    {
                        <option value="@m.WorkspaceId" selected="@(m.WorkspaceId == currentMember?.WorkspaceId)">@m.Workspace?.Name</option>
                    }
                </select>
            </form>
            <button type="button" class="btn btn-ghost btn-sm ws-create-btn" onclick="Modal.open('create-workspace-modal')">+ Tạo không gian mới</button>
        </div>
    }

    <div class="sidebar-section">
        <div class="sidebar-section-title">Điều hướng</div>
        <nav class="sidebar-nav">
            <a class="sidebar-nav-item active" asp-controller="Boards" asp-action="Index">
                <span class="sidebar-nav-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="9"></rect>
                        <rect x="14" y="3" width="7" height="5"></rect>
                        <rect x="14" y="12" width="7" height="9"></rect>
                        <rect x="3" y="16" width="7" height="5"></rect>
                    </svg>
                </span>
                <span class="sidebar-nav-label">Các bảng</span>
            </a>

            <a class="sidebar-nav-item" asp-controller="Boards" asp-action="Templates">
                <span class="sidebar-nav-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                        <polyline points="2 17 12 22 22 17"></polyline>
                        <polyline points="2 12 12 17 22 12"></polyline>
                    </svg>
                </span>
                <span class="sidebar-nav-label">Mẫu bảng việc</span>
            </a>

            <a class="sidebar-nav-item" asp-controller="Workspace" asp-action="Members">
                <span class="sidebar-nav-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                </span>
                <span class="sidebar-nav-label">Thành viên nhóm</span>
            </a>

            <a class="sidebar-nav-item" asp-controller="Workspace" asp-action="Settings">
                <span class="sidebar-nav-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="3"></circle>
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                    </svg>
                </span>
                <span class="sidebar-nav-label">Cài đặt Không gian</span>
            </a>
        </nav>
    </div>

    <div class="sidebar-section" style="margin-top: auto; padding-bottom: 20px;">
        <div class="sidebar-section-title">Thao tác nhanh</div>
        <button type="button" class="btn btn-secondary btn-sm" style="width: 100%;" data-open-create-board>
            <span>+ Tạo bảng mới</span>
        </button>
    </div>
</aside>

@if (memberships.Count > 0)
{
    <!-- Modal: Tạo không gian làm việc mới -->
    <div class="modal-overlay" id="create-workspace-modal" role="dialog" aria-modal="true">
        <div class="modal-window" style="width: 440px;">
            <div class="modal-header">
                <h3 class="modal-title">Tạo không gian làm việc mới</h3>
                <button type="button" class="modal-close-btn" data-modal-close aria-label="Đóng">✕</button>
            </div>
            <form asp-controller="Workspace" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="form-group" style="margin-bottom: 0;">
                        <label class="form-label" for="new-ws-name">Tên không gian <span style="color:var(--danger)">*</span></label>
                        <input type="text" class="form-control" id="new-ws-name" name="name" maxlength="100" placeholder="VD: Nhóm Marketing" required />
                        <small style="color: var(--text-subtle); font-size: 12px; margin-top: 4px; display: block;">
                            Không gian mới là của riêng bạn. Chỉ những người bạn mời mới nhìn thấy các bảng trong đó.
                        </small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-ghost" data-modal-close>Hủy</button>
                    <button type="submit" class="btn btn-primary">Tạo không gian</button>
                </div>
            </form>
        </div>
    </div>
}
