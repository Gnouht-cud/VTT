@* Header toàn hệ thống - Phong cách hồng pastel #fd79a8 *@
@{
    var isAuth = User.Identity?.IsAuthenticated == true;
    var userName = isAuth ? (User.Identity?.Name ?? "Người dùng") : "Khách";
    var userEmail = isAuth ? (User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "") : "";
    var currentWs = isAuth ? await Access.GetCurrentAsync() : null;
    var role = currentWs?.Role == "Admin" ? "Quản trị viên" : "Thành viên";
    var wsLabel = currentWs?.Workspace?.Name ?? "Không gian VTT";
    var initial = string.IsNullOrEmpty(userName) ? "D" : userName[0].ToString().ToUpper();
}

<header class="app-header">
    <div class="header-left">
        <button type="button" class="sidebar-toggle-btn" title="Thu gọn / Mở rộng thanh bên" aria-label="Toggle Sidebar">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>

        <a class="logo-brand" asp-controller="Boards" asp-action="Index">
            <div class="logo-icon">
                <svg viewBox="0 0 24 24">
                    <rect x="3" y="3" width="7" height="15" rx="1.5"></rect>
                    <rect x="14" y="3" width="7" height="10" rx="1.5"></rect>
                </svg>
            </div>
            <span>VTT</span>
        </a>

        <nav class="header-nav-links">
            <a class="nav-link-item active" asp-controller="Boards" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                    <line x1="9" y1="3" x2="9" y2="21"></line>
                </svg>
                <span>Bảng việc</span>
            </a>
            <a class="nav-link-item" asp-controller="Boards" asp-action="Templates">
                <span>Mẫu bảng</span>
            </a>
        </nav>
    </div>

    <div class="header-search">
        <span class="search-icon-decor">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
        </span>
        <input type="search" id="global-search-input" placeholder="Tìm kiếm bảng, thẻ, hoặc nội dung..." aria-label="Tìm kiếm" autocomplete="off" />
    </div>

    <div class="header-right">
        <button type="button" class="btn btn-primary btn-sm" data-open-create-board>
            <span style="font-size:16px; font-weight:800;">+</span>
            <span>Tạo mới</span>
        </button>

        <div style="position: relative;">
            <button type="button" class="header-action-btn" id="header-bell-btn" title="Thông báo" aria-label="Thông báo">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
                <span class="badge-dot"></span>
            </button>
            <div class="dropdown-menu" id="header-bell-dropdown" style="width: 290px;">
                <div class="dropdown-header">
                    <div class="user-name">Thông báo gần đây</div>
                    <div class="user-email">Cập nhật từ không gian làm việc</div>
                </div>
                <div style="padding: 6px;">
                    <div class="dropdown-item" style="font-size: 12.5px; padding: 8px;">
                        <div>
                            <strong>@userName</strong> đang làm việc trong <strong>@wsLabel</strong>
                            <div style="font-size: 11px; color: var(--text-subtle);">Vừa xong</div>
                        </div>
                    </div>
                    <div class="dropdown-item" style="font-size: 12.5px; padding: 8px;">
                        <div>
                            Hệ thống quản lý công việc phân tán sẵn sàng
                            <div style="font-size: 11px; color: var(--text-subtle);">Hôm nay</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="profile-dropdown-wrapper">
            <button type="button" class="user-avatar-btn" title="@userName" aria-label="Hồ sơ">
                @initial
            </button>
            <div class="dropdown-menu">
                <div class="dropdown-header">
                    <div class="user-name">@userName</div>
                    <div class="user-email">@userEmail</div>
                    <div style="margin-top: 4px;"><span class="badge badge-pink">@role</span></div>
                </div>
                <a class="dropdown-item" asp-controller="Boards" asp-action="Index">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    </svg>
                    <span>Trang chủ bảng việc</span>
                </a>
                <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                    <span>Hồ sơ cá nhân</span>
                </a>
                <a class="dropdown-item" asp-controller="Workspace" asp-action="Members">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                    </svg>
                    <span>Thành viên nhóm</span>
                </a>
                <div style="height: 1px; background: var(--border-light); margin: 4px 0;"></div>
                @if (isAuth)
                {
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="dropdown-item" style="color: var(--danger); border: 0; width: 100%; text-align: left; background: transparent; cursor: pointer;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                            <span>Đăng xuất</span>
                        </button>
                    </form>
                }
                else
                {
                    <a class="dropdown-item" asp-controller="Account" asp-action="Login">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                            <polyline points="10 17 15 12 10 7"></polyline>
                            <line x1="15" y1="12" x2="3" y2="12"></line>
                        </svg>
                        <span>Đăng nhập</span>
                    </a>
                }
            </div>
        </div>
    </div>
</header>
