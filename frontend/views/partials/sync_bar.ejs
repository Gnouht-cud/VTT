<!-- Thanh trạng thái kết nối & Đồng bộ thời gian thực -->
<div id="vtt-sync-status-bar" class="sync-status-bar status-online" title="Trạng thái đồng bộ thời gian thực với máy chủ">
  <div class="sync-dot"></div>
  <span id="sync-status-text">Đã kết nối (Thời gian thực)</span>
  <button type="button" id="btn-manual-sync" class="btn-sync-action" title="Nhấn để đồng bộ lại dữ liệu mới nhất từ máy chủ">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/>
    </svg>
    <span>Đồng bộ ngay</span>
  </button>
</div>
