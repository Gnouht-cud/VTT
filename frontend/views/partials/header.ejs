<%
  var isAuth = user != null;
  var userName = isAuth ? user.fullName : "Demo";
  var userEmail = isAuth ? user.email : "demo@vtt.local";
  var role = isAuth ? user.role : "Member";
  var initial = isAuth && user.avatar ? user.avatar : "D";
  var unreadCount = typeof unreadNotifCount !== 'undefined' ? unreadNotifCount : 0;
%>

<header class="app-header">
  <div class="header-left">
    <button type="button" class="sidebar-toggle-btn" title="Thu gọn / Mở rộng thanh bên" aria-label="Toggle Sidebar">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <a class="logo-brand" href="/boards">
      <div class="logo-icon">
        <svg viewBox="0 0 24 24">
          <rect x="3" y="3" width="7" height="15" rx="1.5"></rect>
          <rect x="14" y="3" width="7" height="10" rx="1.5"></rect>
        </svg>
      </div>
      <span>VTT</span>
    </a>

    <nav class="header-nav-links">
      <a class="nav-link-item" href="/boards">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="18" height="18" rx="2"></rect>
          <line x1="9" y1="3" x2="9" y2="21"></line>
        </svg>
        <span>Bảng việc</span>
      </a>
      <a class="nav-link-item" href="/templates">
        <span>Mẫu bảng</span>
      </a>
      <a class="nav-link-item" href="/reports">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="20" x2="18" y2="10"></line>
          <line x1="12" y1="20" x2="12" y2="4"></line>
          <line x1="6" y1="20" x2="6" y2="14"></line>
        </svg>
        <span>Thống kê</span>
      </a>
    </nav>
  </div>

  <div class="header-search">
    <span class="search-icon-decor">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </span>
    <input type="search" id="global-search-input" placeholder="Tìm kiếm công việc, bảng việc..." aria-label="Tìm kiếm" autocomplete="off" />
  </div>

  <div class="header-right">
    <!-- Nút tạo bảng mới -->
    <button type="button" class="btn btn-primary btn-sm" id="btn-header-create-board">
      <span style="font-size:16px; font-weight:800;">+</span>
      <span>Tạo mới</span>
    </button>

    <!-- Nút Chuông Thông báo -->
    <div style="position: relative;">
      <button type="button" class="header-action-btn" id="header-bell-btn" title="Thông báo" aria-label="Thông báo">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
        <span class="badge-dot" id="header-notif-dot" style="<%= unreadCount > 0 ? '' : 'display:none;' %>"></span>
      </button>

      <div class="dropdown-menu" id="header-bell-dropdown" style="width: 320px;">
        <div class="dropdown-header" style="display: flex; justify-content: space-between; align-items: center;">
          <div>
            <div class="user-name">Thông báo</div>
            <div class="user-email">Cập nhật công việc & nhóm</div>
          </div>
          <button type="button" id="btn-mark-all-read" style="background: none; border: none; color: var(--primary-hover); font-size: 11.5px; font-weight: 700; cursor: pointer;">
            Đọc tất cả
          </button>
        </div>
        <div id="header-notifications-list" style="max-height: 280px; overflow-y: auto; padding: 6px;">
          <div style="text-align: center; padding: 12px; font-size: 12.5px; color: var(--text-muted);">
            Đang tải thông báo...
          </div>
        </div>
      </div>
    </div>

    <!-- Dropdown người dùng -->
    <div class="profile-dropdown-wrapper">
      <button type="button" class="user-avatar-btn" title="<%= userName %>" aria-label="Hồ sơ">
        <%= initial %>
      </button>
      <div class="dropdown-menu">
        <div class="dropdown-header">
          <div class="user-name"><%= userName %></div>
          <div class="user-email"><%= userEmail %></div>
          <div style="margin-top: 4px;">
            <span class="badge badge-pink"><%= role %></span>
          </div>
        </div>
        <a class="dropdown-item" href="/boards">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          </svg>
          <span>Trang chủ bảng việc</span>
        </a>
        <a class="dropdown-item" href="/account/profile">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <span>Hồ sơ cá nhân</span>
        </a>
        <a class="dropdown-item" href="/workspace/members">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
          </svg>
          <span>Thành viên nhóm</span>
        </a>
        <a class="dropdown-item" href="/reports">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="20" x2="18" y2="10"></line>
            <line x1="12" y1="20" x2="12" y2="4"></line>
            <line x1="6" y1="20" x2="6" y2="14"></line>
          </svg>
          <span>Thống kê, báo cáo</span>
        </a>

        <div style="height: 1px; background: var(--border-light); margin: 4px 0;"></div>
        <% if (isAuth) { %>
        <a class="dropdown-item" href="/logout" style="color: var(--danger);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
          <span>Đăng xuất</span>
        </a>
        <% } else { %>
        <a class="dropdown-item" href="/login">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
            <polyline points="10 17 15 12 10 7"></polyline>
            <line x1="15" y1="12" x2="3" y2="12"></line>
          </svg>
          <span>Đăng nhập</span>
        </a>
        <% } %>
      </div>
    </div>
  </div>
</header>

<script>
  window.VTT_CURRENT_USER_ID = <%= isAuth ? user.id : 'null' %>;
</script>
<script src="/js/header.js"></script>
