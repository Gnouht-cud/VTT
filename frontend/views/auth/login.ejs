<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Đăng nhập | VTT - Quản lý công việc phân tán</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/trello.css" />
</head>
<body style="background: var(--bg-app);">
  <div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 32px 16px;">
    <div style="width: 100%; max-width: 440px; background: #ffffff; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); border: 1px solid var(--border-light); padding: 36px 32px;">
      
      <div style="text-align: center; margin-bottom: 28px;">
        <div style="display: inline-flex; align-items: center; justify-content: center; width: 56px; height: 56px; border-radius: 16px; background: linear-gradient(135deg, #fd79a8 0%, #fab1a0 100%); color: #fff; margin-bottom: 12px; box-shadow: 0 4px 14px rgba(253, 121, 168, 0.35);">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor">
            <rect x="3" y="3" width="7" height="15" rx="1.5"></rect>
            <rect x="14" y="3" width="7" height="10" rx="1.5"></rect>
          </svg>
        </div>
        <h1 style="font-size: 22px; font-weight: 800; color: var(--text-main); margin-bottom: 4px;">Đăng nhập VTT</h1>
        <p style="font-size: 13.5px; color: var(--text-muted);">Hệ thống quản lý công việc và cộng tác phân tán</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
      <div style="background: var(--danger-bg); color: var(--danger-text); padding: 10px 14px; border-radius: var(--radius-sm); font-size: 13px; font-weight: 600; margin-bottom: 18px; border: 1px solid rgba(255,118,117,0.3); display: flex; align-items: center; gap: 8px;">
        <span>⚠</span>
        <span><%= error %></span>
      </div>
      <% } %>

      <form action="/login" method="post" id="login-form">
        <input type="hidden" name="returnUrl" value="<%= typeof returnUrl !== 'undefined' ? returnUrl : '/boards' %>" />

        <div class="form-group">
          <label class="form-label" for="login-username">Email hoặc Tên người dùng</label>
          <input type="text" class="form-control" id="login-username" name="emailOrUsername" placeholder="demo@vtt.local hoặc demo" required autofocus />
        </div>

        <div class="form-group">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
            <label class="form-label" for="login-password" style="margin-bottom: 0;">Mật khẩu</label>
          </div>
          <input type="password" class="form-control" id="login-password" name="password" placeholder="Nhập mật khẩu..." required />
        </div>

        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
          <label style="display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--text-muted); cursor: pointer;">
            <input type="checkbox" name="rememberMe" value="true" style="accent-color: var(--primary);" checked />
            <span>Ghi nhớ đăng nhập</span>
          </label>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 10px; font-size: 14px;">
          Đăng nhập
        </button>
      </form>

      <div style="position: relative; text-align: center; margin: 24px 0;">
        <div style="position: absolute; inset: 0; display: flex; align-items: center;">
          <div style="width: 100%; border-top: 1px solid var(--border-light);"></div>
        </div>
        <span style="position: relative; background: #ffffff; padding: 0 12px; font-size: 12px; color: var(--text-subtle); text-transform: uppercase;">
          Hoặc trải nghiệm nhanh
        </span>
      </div>

      <form action="/quick-login-demo" method="post">
        <button type="submit" class="btn btn-secondary" style="width: 100%; padding: 9px; font-size: 13.5px;">
          <span>⚡ Đăng nhập bằng tài khoản Demo (Admin)</span>
        </button>
      </form>

      <div style="text-align: center; margin-top: 24px; font-size: 13px; color: var(--text-muted);">
        Chưa có tài khoản?
        <a href="/register" style="color: var(--primary-hover); font-weight: 700; text-decoration: underline;">Đăng ký ngay</a>
      </div>
    </div>
  </div>
</body>
</html>
