<!-- Modal Chi tiết Công việc (Card Detail Modal) -->
<div class="modal-overlay" id="card-detail-modal" role="dialog" aria-modal="true">
  <div class="modal-window card-modal-window" style="max-width: 820px;">
    
    <div class="card-modal-header">
      <div class="card-modal-title-box">
        <input type="text" class="card-modal-title-input" id="card-modal-title" placeholder="Tiêu đề công việc..." maxlength="200" />
        <div class="card-modal-sub">
          trong danh sách <b id="card-modal-list-title">...</b>
          <span style="margin-left: 10px; font-size: 11px; color: var(--text-subtle);">Phiên bản: v<span id="card-modal-version">1</span></span>
        </div>
      </div>
      <button type="button" class="modal-close-btn" data-modal-close aria-label="Đóng">✕</button>
    </div>

    <div class="card-modal-grid">
      <!-- Cột chính: Mô tả, Tiến độ, Bình luận, Lịch sử -->
      <div class="card-detail-main">
        
        <!-- Đổi trạng thái & Tiến độ nhanh -->
        <div style="background: var(--bg-subtle); border-radius: var(--radius-sm); padding: 14px 18px; margin-bottom: 20px; border: 1px solid var(--border-light);">
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
            <div>
              <label class="form-label" style="font-size: 12px; margin-bottom: 4px;">Trạng thái công việc</label>
              <select id="card-modal-status-select" class="form-control" style="font-size: 13px; height: 34px;">
                <option value="">Đang tải danh sách cột...</option>
              </select>
            </div>
            <div>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                <label class="form-label" style="font-size: 12px; margin-bottom: 0;">Tiến độ hoàn thành</label>
                <span id="card-modal-progress-label" style="font-weight: 800; font-size: 13px; color: var(--primary-hover);">0%</span>
              </div>
              <input type="range" id="card-modal-progress-range" min="0" max="100" step="5" value="0" style="width: 100%; accent-color: var(--primary);" />
            </div>
          </div>
        </div>

        <!-- Mô tả -->
        <div class="card-detail-section">
          <h4 class="section-label-h4">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="8" y1="6" x2="21" y2="6"></line>
              <line x1="8" y1="12" x2="21" y2="12"></line>
              <line x1="8" y1="18" x2="21" y2="18"></line>
              <line x1="3" y1="6" x2="3.01" y2="6"></line>
              <line x1="3" y1="12" x2="3.01" y2="12"></line>
              <line x1="3" y1="18" x2="3.01" y2="18"></line>
            </svg>
            <span>Mô tả chi tiết</span>
          </h4>
          <textarea class="card-desc-textarea" id="card-modal-desc" rows="3" placeholder="Thêm mô tả chi tiết cho công việc này..."></textarea>
          <div style="margin-top: 8px;">
            <button type="button" class="btn btn-primary btn-sm" id="card-modal-save-desc">Lưu mô tả</button>
          </div>
        </div>

        <!-- Tabs: Bình luận & Lịch sử thay đổi -->
        <div class="card-detail-section" style="margin-top: 24px;">
          <div style="display: flex; gap: 16px; border-bottom: 1px solid var(--border-light); margin-bottom: 16px;">
            <button type="button" id="tab-btn-comments" class="card-tab-btn active" style="padding-bottom: 8px; font-weight: 700; font-size: 13.5px; border-bottom: 2px solid var(--primary); background: none; border-top: none; border-left: none; border-right: none; cursor: pointer;">
              💬 Bình luận trao đổi
            </button>
            <button type="button" id="tab-btn-activities" class="card-tab-btn" style="padding-bottom: 8px; font-weight: 600; font-size: 13.5px; color: var(--text-muted); background: none; border: none; cursor: pointer;">
              🕒 Lịch sử thay đổi
            </button>
          </div>

          <!-- Tab Content 1: Bình luận -->
          <div id="tab-content-comments">
            <div class="comment-input-box">
              <div class="avatar avatar-sm" style="background: linear-gradient(135deg, #fd79a8 0%, #fab1a0 100%);">
                <%= user ? user.avatar : 'U' %>
              </div>
              <div style="flex: 1;">
                <textarea id="card-modal-new-comment" rows="2" placeholder="Viết bình luận cho công việc này (Ctrl + Enter để gửi)..."></textarea>
                <div style="margin-top: 6px;">
                  <button type="button" class="btn btn-primary btn-sm" id="card-modal-submit-comment">Gửi bình luận</button>
                </div>
              </div>
            </div>

            <div class="comment-timeline" id="card-modal-comments-list">
              <!-- Render động bằng JS -->
            </div>
          </div>

          <!-- Tab Content 2: Lịch sử thay đổi -->
          <div id="tab-content-activities" style="display: none;">
            <div id="card-modal-activities-list" style="display: flex; flex-direction: column; gap: 10px; font-size: 13px;">
              <!-- Render động bằng JS -->
            </div>
          </div>

        </div>

      </div>

      <!-- Cột sidebar thao tác -->
      <div class="sidebar-action-col">
        
        <!-- Mức ưu tiên -->
        <div style="margin-bottom: 16px;">
          <h5>Mức độ ưu tiên</h5>
          <select id="card-modal-priority" class="form-control" style="font-size: 12.5px; height: 34px;">
            <option value="Urgent">🔴 Khẩn cấp (Urgent)</option>
            <option value="High">🟠 Cao (High)</option>
            <option value="Medium" selected>🟡 Trung bình (Medium)</option>
            <option value="Low">🟢 Thấp (Low)</option>
          </select>
        </div>

        <!-- Hạn chót -->
        <div style="margin-bottom: 16px;">
          <h5>Ngày hết hạn</h5>
          <input type="datetime-local" class="sidebar-due-input" id="card-modal-due" style="font-size: 12px;" />
        </div>

        <!-- Phân công thành viên -->
        <div style="margin-bottom: 18px;">
          <h5>Giao việc cho thành viên</h5>
          <div id="card-modal-members-picker" style="max-height: 140px; overflow-y: auto; background: var(--bg-subtle); border: 1px solid var(--border-light); border-radius: var(--radius-sm); padding: 6px 10px; display: flex; flex-direction: column; gap: 6px; font-size: 12.5px;">
            <!-- Render danh sách checkbox thành viên nhóm -->
          </div>
        </div>

        <!-- Các nút thao tác -->
        <h5>Thao tác công việc</h5>
        <button type="button" class="btn btn-primary btn-sm" id="card-modal-save-all-btn" style="width: 100%; margin-bottom: 8px;">
          <span>✓ Lưu toàn bộ thay đổi</span>
        </button>

        <button type="button" class="sidebar-action-btn btn-archive" id="card-modal-delete-btn" style="color: var(--danger); border-color: rgba(255,118,117,0.3);">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="3 6 5 6 21 6"></polyline>
            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          </svg>
          <span>Xóa vĩnh viễn công việc</span>
        </button>

      </div>
    </div>

  </div>
</div>
