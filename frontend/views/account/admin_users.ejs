<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Quản lý & Khóa/Mở khóa tài khoản | VTT</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/trello.css" />
  <link rel="stylesheet" href="/css/chat.css" />
</head>
<body>
  <div class="app-root">
    <%- include('../partials/header') %>

    <div class="app-body">
      <%- include('../partials/sidebar') %>

      <main class="app-content">
        <div class="dashboard-container" style="max-width: 960px; padding: 32px 24px;">
          
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px;">
            <div>
              <div style="display: flex; align-items: center; gap: 8px;">
                <h1 style="font-size: 24px; font-weight: 800; color: var(--text-main); margin: 0;">Quản lý tài khoản người dùng</h1>
                <span class="badge badge-pink">Dành cho Admin</span>
              </div>
              <p style="font-size: 13.5px; color: var(--text-muted); margin-top: 4px;">
                Xem danh sách tất cả tài khoản trong hệ thống, quản lý quyền hạn và thực hiện Khóa / Mở khóa tài khoản tức thì.
              </p>
            </div>
            <a href="/boards" class="btn btn-secondary btn-sm">Quay lại bảng việc</a>
          </div>

          <% if (typeof success !== 'undefined' && success) { %>
          <div style="background: var(--success-bg); color: var(--success-text); padding: 12px 16px; border-radius: var(--radius-sm); font-size: 13.5px; font-weight: 600; margin-bottom: 20px; border: 1px solid rgba(85,239,196,0.5); display: flex; align-items: center; gap: 8px;">
            <span>✓</span>
            <span><%= success %></span>
          </div>
          <% } %>

          <% if (typeof error !== 'undefined' && error) { %>
          <div style="background: var(--danger-bg); color: var(--danger-text); padding: 12px 16px; border-radius: var(--radius-sm); font-size: 13.5px; font-weight: 600; margin-bottom: 20px; border: 1px solid rgba(255,118,117,0.3); display: flex; align-items: center; gap: 8px;">
            <span>⚠</span>
            <span><%= error %></span>
          </div>
          <% } %>

          <div style="background: #ffffff; border-radius: var(--radius-md); border: 1px solid var(--border-light); box-shadow: var(--shadow-sm); overflow: hidden;">
            <div style="padding: 16px 20px; border-bottom: 1px solid var(--border-light); display: flex; justify-content: space-between; align-items: center; background: var(--bg-subtle);">
              <span style="font-weight: 700; font-size: 14px; color: var(--text-main);">
                Danh sách người dùng (<%= allUsers.length %> tài khoản)
              </span>
              <span style="font-size: 12px; color: var(--text-muted);">
                Trạng thái khóa được đồng bộ thời gian thực qua Socket
              </span>
            </div>

            <div style="overflow-x: auto;">
              <table style="width: 100%; border-collapse: collapse; font-size: 13.5px; text-align: left;">
                <thead>
                  <tr style="border-bottom: 1px solid var(--border-light); color: var(--text-muted); font-size: 12.5px; text-transform: uppercase;">
                    <th style="padding: 12px 20px;">Người dùng</th>
                    <th style="padding: 12px 16px;">Tên đăng nhập / Email</th>
                    <th style="padding: 12px 16px;">Vai trò</th>
                    <th style="padding: 12px 16px;">Trạng thái</th>
                    <th style="padding: 12px 16px;">Ngày tạo</th>
                    <th style="padding: 12px 20px; text-align: right;">Hành động</th>
                  </tr>
                </thead>
                <tbody>
                  <% allUsers.forEach(function(u) { %>
                  <tr style="border-bottom: 1px solid var(--border-light); transition: background 0.15s ease;" onmouseover="this.style.background='var(--bg-subtle)'" onmouseout="this.style.background='transparent'">
                    <td style="padding: 14px 20px;">
                      <div style="display: flex; align-items: center; gap: 12px;">
                        <div class="avatar avatar-sm" style="font-weight: 700; background: <%= u.isLocked ? '#b2bec3' : 'linear-gradient(135deg, #fd79a8 0%, #fab1a0 100%)' %>;">
                          <%= u.avatar || u.fullName[0].toUpperCase() %>
                        </div>
                        <div>
                          <div style="font-weight: 700; color: <%= u.isLocked ? 'var(--text-subtle)' : 'var(--text-main)' %>;">
                            <%= u.fullName %>
                            <% if (user && user.id === u.id) { %>
                              <span style="font-size: 11px; color: var(--primary-hover); font-weight: 600;">(Bạn)</span>
                            <% } %>
                          </div>
                        </div>
                      </div>
                    </td>

                    <td style="padding: 14px 16px;">
                      <div style="font-weight: 500; color: var(--text-main);">@<%= u.userName %></div>
                      <div style="font-size: 12px; color: var(--text-muted);"><%= u.email %></div>
                    </td>

                    <td style="padding: 14px 16px;">
                      <span class="badge <%= u.role === 'Admin' ? 'badge-pink' : '' %>" style="<%= u.role !== 'Admin' ? 'background:var(--bg-subtle); color:var(--text-muted);' : '' %>">
                        <%= u.role %>
                      </span>
                    </td>

                    <td style="padding: 14px 16px;">
                      <% if (u.isLocked) { %>
                        <span class="badge" style="background: var(--danger-bg); color: var(--danger-text); font-weight: 700; display: inline-flex; align-items: center; gap: 4px;">
                          🔒 Đã bị khóa
                        </span>
                      <% } else { %>
                        <span class="badge" style="background: var(--success-bg); color: var(--success-text); font-weight: 700; display: inline-flex; align-items: center; gap: 4px;">
                          ✓ Hoạt động
                        </span>
                      <% } %>
                    </td>

                    <td style="padding: 14px 16px; font-size: 12px; color: var(--text-muted);">
                      <%= new Date(u.createdAt).toLocaleDateString('vi-VN') %>
                    </td>

                    <td style="padding: 14px 20px; text-align: right;">
                      <% if (user && user.id === u.id) { %>
                        <span style="font-size: 12px; color: var(--text-subtle); font-style: italic;">Không thể tự khóa</span>
                      <% } else { %>
                        <form action="/admin/users/<%= u.id %>/toggle-lock" method="post" style="display: inline-block;">
                          <% if (u.isLocked) { %>
                            <button type="submit" class="btn btn-sm" style="background: var(--success-bg); color: var(--success-text); border: 1px solid var(--success); font-weight: 700; padding: 4px 12px;">
                              🔓 Mở khóa
                            </button>
                          <% } else { %>
                            <button type="submit" class="btn btn-sm btn-danger" style="padding: 4px 12px;" onclick="return confirm('Bạn có chắc chắn muốn KHÓA tài khoản <%= u.fullName %>? Người này sẽ không thể đăng nhập.')">
                              🔒 Khóa tài khoản
                            </button>
                          <% } %>
                        </form>
                      <% } %>
                    </td>
                  </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>

        </div>
      </main>
    </div>
  </div>

  <%- include('../partials/toast') %>
  <%- include('../partials/chat_drawer') %>
  <%- include('../partials/sync_bar') %>

  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/modal.js"></script>
  <script src="/js/toast.js"></script>
  <script src="/js/socket-client.js"></script>
  <script src="/js/chat.js"></script>
</body>
</html>
